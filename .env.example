# Copy to .env.local for local reference. NEVER commit real values.
#
# Only PUBLIC values belong in the browser: the Supabase project URL and the
# publishable (or legacy anon) key. Their safety depends on correct RLS and
# grants (see supabase/migrations, added in Phase 2).
#
# NEVER put the service_role / secret key, admin passwords, or access tokens
# in this project, in the frontend, or in chat messages.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
